{
  "apiVersion": "v1",
  "kind": "Pod",
  "metadata": {
    "name": "cpu-low",
    "namespace": "lab5"
  },
  "spec": {
    "priorityClassName": "lab5-low",
    "restartPolicy": "Never",
    "terminationGracePeriodSeconds": 1,
    "containers": [
      {
        "name": "hold",
        "image": "de-lab5:local",
        "imagePullPolicy": "Never",
        "command": [
          "python",
          "-c",
          "import time; print('running', flush=True); time.sleep(120)"
        ],
        "resources": {
          "requests": {
            "cpu": "10950m",
            "memory": "32Mi"
          },
          "limits": {
            "cpu": "10950m",
            "memory": "64Mi"
          }
        }
      }
    ]
  }
}
